# Part 7: Real-time emotion recognition function
def real_time_emotion_recognition(audio_file_path, model, feature_extractor, label_encoder):
    """
    Recognize emotion from an audio file in real-time
    """
    # Extract features
    features = feature_extractor.extract_all_features(audio_file_path)
    
    if features is None:
        print("Error processing audio file")
        return None
    
    # Reshape for model input
    features = np.expand_dims(features, axis=0)
    
    # Predict
    predictions = model.predict(features)
    emotion_idx = np.argmax(predictions[0])
    confidence = predictions[0][emotion_idx]
    
    # Decode emotion
    emotion = label_encoder.inverse_transform([emotion_idx])[0]
    
    return {
        'emotion': emotion,
        'confidence': confidence,
        'all_probabilities': dict(zip(label_encoder.classes_, predictions[0]))
    }

# Part 8: Audio processing pipeline for real data
def process_audio_dataset(audio_dir, feature_extractor):
    """
    Process a directory of audio files for training
    """
    X = []
    y = []
    file_paths = []
    
    # Assuming directory structure: audio_dir/emotion/*.wav
    for emotion_folder in os.listdir(audio_dir):
        emotion_path = os.path.join(audio_dir, emotion_folder)
        
        if os.path.isdir(emotion_path):
            for audio_file in os.listdir(emotion_path):
                if audio_file.endswith(('.wav', '.mp3', '.ogg')):
                    audio_path = os.path.join(emotion_path, audio_file)
                    
                    # Extract features
                    features = feature_extractor.extract_all_features(audio_path)
                    
                    if features is not None:
                        X.append(features)
                        y.append(emotion_folder)
                        file_paths.append(audio_path)
                        
                        print(f"Processed: {audio_file}")
    
    return np.array(X), np.array(y), file_paths

